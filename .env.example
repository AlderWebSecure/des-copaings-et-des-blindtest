# ── SPOTIFY (côté frontend) ──────────────────────────────────────
# Récupérer sur https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=ton_client_id_ici
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# ── SPOTIFY (côté serveur — Vercel env vars) ─────────────────────
# Ne jamais mettre dans VITE_ (serait exposé publiquement)
SPOTIFY_CLIENT_ID=ton_client_id_ici
SPOTIFY_CLIENT_SECRET=ton_client_secret_ici